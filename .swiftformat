# SwiftFormat configuration
#
# Rules: https://github.com/nicklockwood/SwiftFormat/blob/master/Rules.md
#

--header "\n  {file}\n  Copyright © Paulo Fierro. All rights reserved.\n"
--swiftversion 6.3
--language-mode 5

# File options
--exclude Package.swift

# Formatting options
--decimal-grouping 3
--hex-grouping ignore
--hex-literal-case lowercase
--ifdef no-indent
--import-grouping testable-first
--self init-only
--short-optionals except-properties
--wrap-arguments before-first
--wrap-parameters before-first
--wrap-collections before-first
--wrap-conditions after-first
--max-width 120

# Rules
--lint-only unusedPrivateDeclarations
# `appDelegate` has no reader in the source — @NSApplicationDelegateAdaptor consumes it — so the
# rule reports it as unused. Removing it would strip the app of every AppKit surface it owns.
--preserve-decls appDelegate

--enable emptyExtensions
--enable isEmpty
--enable noForceTryInTests
--enable noForceUnwrapInTests
--enable preferFinalClasses
--enable redundantAsync
--enable redundantThrows
--enable redundantEquatable
--enable redundantMemberwiseInit
--enable redundantVariable

--disable hoistPatternLet
--disable trailingClosures # Prefer explicit closures
--disable trailingCommas
--disable unusedArguments
--disable wrapMultilineStatementBraces
--disable redundantSendable # We want explicit Sendable as a signal of cross-actor intent
--disable wrapFunctionBodies
--disable wrapPropertyBodies
--disable docComments
--disable consecutiveSpaces
--disable sortImports 
